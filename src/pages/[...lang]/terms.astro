---
/********************************************************************* 
Author: Sukanta Manna  
Purpose: Terms of Service, Privacy Policy, and Open-Data Legal & 
         Telemetry Disclaimer page supporting multi-language routes.
**********************************************************************/
import Layout from "../../layouts/main.astro"
import { ui } from "../../i18n/ui"

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, 
    { params: { lang: 'bn' } },
    { params: { lang: 'es' } },  
    { params: { lang: 'fr' } },  
    { params: { lang: 'hi' } },
    { params: { lang: 'ja' } }, 
    { params: { lang: 'ru' } },
    { params: { lang: 'zh' } }, 
  ];
}

const { lang = "en" } = Astro.params
const currentLang = (lang || "en") as keyof typeof ui
const t = (key: keyof typeof ui['en']) => {
        const langObj = ui[currentLang] as Record<keyof typeof ui['en'], string>;
        return langObj[key] || ui['en'][key];
    };
const localizeUrl = (url: string) =>
  currentLang === "en" ? url : `/${currentLang}${url}`
---

<Layout>  
  <div class="h-full w-full min-h-screen overflow-y-auto bg-slate-50 dark:bg-slate-950 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-8">
      
      {/* Header */}
      <div class="border-b border-slate-200 dark:border-slate-800 pb-6 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
          {t("terms.heading")}
        </h1>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          {t("terms.updated")}
        </p>
      </div>

      {/* Main Content Area */}
      <div class="space-y-10 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
        
        {/* Section 1: Open-Data Disclosure & Telemetry Disclaimer */}
        <section class="space-y-4">
          <strong class="block text-xl font-bold text-slate-900 dark:text-slate-100">
            {t("terms.1.heading")}
          </strong>
          <p>
            {t("terms.1.p1")}
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>{t("terms.1.p2s")}</strong> {t("terms.1.p2")}
            </li>
            <li>
              <strong>{t("terms.1.p3s")}</strong> {t("terms.1.p3")}
            </li>
            <li>
              <strong>{t("terms.1.p4s")}</strong> {t("terms.1.p4")}
            </li>
          </ul>
        </section>

        {/* Section 2: Terms of Service */}
        <section class="space-y-4">
          <strong class="block text-xl font-bold text-slate-900 dark:text-slate-100">
            {t("terms.2.heading")}
          </strong>
          <p>
            {t("terms.2.p1")}
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>{t("terms.2.p2s")}</strong> {t("terms.2.p2")}
            </li>
            <li>
              <strong>{t("terms.2.p3s")}</strong> {t("terms.2.p3")}
            </li>
            <li>
              <strong>{t("terms.2.p4s")}</strong> {t("terms.2.p4")}
            </li>
          </ul>
        </section>

        {/* Section 3: Privacy Policy */}
        <section class="space-y-4">
          <strong class="block text-xl font-bold text-slate-900 dark:text-slate-100">
            {t("terms.3.heading")}
          </strong>
          <p>
            {t("terms.3.p1")}
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>{t("terms.3.p2s")}</strong> {t("terms.3.p2")}
            </li>
            <li>
              <strong>{t("terms.3.p3s")}</strong> {t("terms.3.p3")}
            </li>
            <li>
              <strong>{t("terms.3.p4s")}</strong> {t("terms.3.p4")}
            </li>
          </ul>
        </section>

        {/* Section 4: Contact Information */}
        <section class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
          <strong class="block text-base font-bold text-slate-900 dark:text-slate-100">
            {t("terms.4.heading")}
          </strong>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
            {t("terms.4.p1")} 
          </p>
          <div class="pt-2 text-xs sm:text-sm">
            <p><strong>Email:</strong> contact@gloneax.org</p>            
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>