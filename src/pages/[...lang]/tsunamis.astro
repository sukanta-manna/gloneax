import TsunamiMap from "../../components/TsunamiMap"
import Layout from "../../layouts/main.astro"

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'bn' } },
    { params: { lang: 'es' } }, 
    { params: { lang: 'fr' } }, 
    { params: { lang: 'hi' } },
    { params: { lang: 'ja' } }, 
    { params: { lang: 'ru' } }, 
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
