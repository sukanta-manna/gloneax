import VolcanoMap from "../../components/VolcanoMap"
import Layout from "../../layouts/main.astro"
import VolcanoStatsSummary from "../../components/VolcanoStatsSummary"

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "bn" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "ru" } },
    { params: { lang: "zh" } },
  ]
}
---

<Layout>
  <div class="flex h-screen w-full flex-col overflow-y-auto">
    <div id="volcanMap" class="">
      <VolcanoMap client:only />
    </div>

    <div class="mx-auto my-4 flex w-full max-w-6xl flex-col gap-8 p-4 sm:p-6">
      <div id="volcanChart" class="w-full shrink-0 mb-6">
        <VolcanoStatsSummary client:visible />
      </div>
    </div>
  </div>
</Layout>
